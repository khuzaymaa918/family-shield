# Copy to .env and fill in your own values. Never commit .env.

# Lead
ANTHROPIC_API_KEY=
GUARDIAN_SEED=
VOICE_ANALYST_SEED=
FAMILY_SEED=
VERIFIER_SEED=
VOICE_ANALYST_ADDRESS=      # agent1q... printed when the Voice Analyst starts
FAMILY_ADDRESS=             # agent1q... printed when the Family agent starts
VERIFIER_ADDRESS=           # agent1q... printed when the Verifier starts
GUARDIAN_ADDRESS=           # optional: Family and Verifier work it out from GUARDIAN_SEED if this is blank
SCAM_INTEL_SEED=
SCAM_INTEL_ADDRESS=         # agent1q... printed when the Scam Intel agent starts
APIFY_TOKEN=                # apify.com -> Settings -> API & Integrations (for: python -m services.scam_intel seed)
CODE_TIMEOUT_SECONDS=180
REPLY_WAIT_SECONDS=0         # keep 0: ASI:One drops replies that arrive late
USE_CARDS=true              # false = plain text replies, no ASI:One cards
DEMO_STUDENT_PHONE=         # the phone that gets the verification call, e.g. +14155550123

# Teammate A
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=          # optional, a voice from https://play.cartesia.ai/voices
CARTESIA_AGENT_ID=          # printed by: python -m services.cartesia_setup
CARTESIA_FROM_NUMBER_ID=    # printed by: python -m services.cartesia_setup
CODE_WEBHOOK_URL=           # public https base that reaches services/code_webhook.py (e.g. cloudflared tunnel)
CODE_WEBHOOK_SECRET=        # any long random string; Cartesia sends it as a Bearer token
CODE_WEBHOOK_PORT=8090

# Teammate B
SUPABASE_URL=
SUPABASE_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
